# 控制面服务（hxai-admin/backend 下执行，默认对外端口与桌面端一致）
HOST=127.0.0.1
PORT=8787
PUBLIC_DIR=../frontend

# 与 Node 版同名：迁移期两边共用同一个签名密钥，已签发的令牌可互认
OWCP_SECRET=hx-control-plane-dev-secret-change-me
OWCP_TOKEN_TTL=43200
OWCP_COOKIE_NAME=owcp_session
OWCP_PUBLIC_BASE_URL=http://127.0.0.1:8787
OWCP_ORG_NAME=HX
OWCP_VERSION=0.1.0
OWCP_DESKTOP_DEEPLINK_SCHEME=hxai
OWCP_ANON_MANIFEST=0
# 迁移导入前设为 1，避免默认管理员占用唯一用户名
OWCP_SEED_DISABLE=0
OWCP_LOGIN_MAX_FAILURES=5
OWCP_LOGIN_LOCK_SECONDS=900
OWCP_LOGIN_WINDOW_SECONDS=900

# 唯一外部依赖：本机 MySQL 8.4（见 README「快速开始」）
MYSQL_DSN='control:control@tcp(127.0.0.1:3306)/hx_control?charset=utf8mb4&parseTime=true&loc=UTC'
# 桌面内置模式改为 sqlite，数据落到 HXAI_DB_PATH（PORT=0 时进程自选回环端口）
HXAI_DB=mysql
HXAI_DB_PATH=./data/control.db
# 插件包上传目录，对应 Node 版 dataDir
DATA_DIR=./data

# 指标
METRICS_ADDR=127.0.0.1:9090
LOG_LEVEL=info
